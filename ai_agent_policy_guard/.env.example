# Security API Key for accessing the evaluation endpoint
# In production, this should be a strong, randomly generated string.
API_KEY=your_secure_api_key_here

# Path to the YAML policy file defining allowed tool actions
POLICY_PATH=policies/default.yaml

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Optional: Host and Port for local development
HOST=0.0.0.0
PORT=8000
